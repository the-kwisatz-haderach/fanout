{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "test": {
      "dependsOn": ["^test"]
    },
    "build": {
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "dependsOn": ["typecheck", "^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "persistent": true,
      "cache": false
    }
  }
}
